      "title": "TCP 三次握手：每一步之后双方各确认了什么",
      "kind": "html",
      "callSeq": 33,
      "resultSeq": 34,
      "replace": null,
      "source": "results/dev-C-grounded-20260917/E01-C-2/widget-1.source.html",
